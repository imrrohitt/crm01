# Copy to .env and fill in values.
# Database: use config/database.yml (see config/database.yml.example) or set DATABASE_URL here to override.

# App
APP_NAME=MyApp
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production-use-long-random-string

# Database (optional override — otherwise uses config/database.yml)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/insta_crm_development

# JWT
JWT_SECRET_KEY=jwt-secret-change-me-use-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis (caching + Celery broker)
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Public URLs
FRONTEND_URL=http://localhost:3000

# Instagram (Instagram API with Instagram Login) - see README "Connecting Instagram"
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# https URL of the API (ngrok in development) + /api/v1/channels/instagram/callback
INSTAGRAM_REDIRECT_URI=
# Any private string. Put the same value in the Meta app webhook "Verify token" field.
# Callback URL is that same public host + /api/v1/channels/instagram/webhook
INSTAGRAM_VERIFY_TOKEN=

# Encrypts stored Instagram tokens. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
ENCRYPTION_KEY=
